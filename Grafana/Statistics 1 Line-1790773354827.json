          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n    container_name,\n    CASE\n        WHEN NOW() - MAX(timestamp) > INTERVAL '60 seconds'\n        THEN 'Offline'\n        ELSE 'Online'\n    END AS status,\n    MAX(timestamp) AS last_seen\nFROM system_stats\nWHERE container_name IN ('monitor1','monitor2','monitor3')\nGROUP BY container_name\nORDER BY container_name;",
          "refId": "Container Status",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
            "groupBy": [
              {
                "property": {
